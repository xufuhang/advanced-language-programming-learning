<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.ncepu.alpl.dao.CmsModuleDao">

    <!--  设置列前缀之后，该resultMap会把符合该前缀的列选中，然后删除列前缀，再匹配属性。
    如果要嵌套匹配，则一级c_，二级s_，而select语句，一层中的列前缀为c_，二层中的列前缀为加c_s_  -->
    <resultMap id="CmsChapterDetailMap"
               type="cn.ncepu.alpl.domain.CmsChapterDetail"
               extends="cn.ncepu.alpl.mapper.CmsChapterMapper.BaseResultMap">
        <collection property="sections"
                    resultMap="cn.ncepu.alpl.mapper.CmsSectionMapper.BaseResultMap"
                    columnPrefix="s_">
        </collection>
    </resultMap>
    <resultMap id="CmsModuleDetailMap"
               type="cn.ncepu.alpl.domain.CmsModuleDetail"
               extends="cn.ncepu.alpl.mapper.CmsModuleMapper.BaseResultMap">
        <collection property="chapters"
                    resultMap="CmsChapterDetailMap"
                    columnPrefix="c_">
        </collection>
    </resultMap>

    <select id="selectMaxSort" resultType="java.lang.Integer">
        SELECT IFNULL(MAX(sort), 0)
        FROM cms_module
    </select>

    <select id="selectDetailById" resultMap="CmsChapterDetailMap">
        (
            SELECT c.*,
                   s.id                s_id,
                   s.title             s_title,
                   s.sort              s_sort,
                   s.chapter_id        s_chapter_id,
                   s.new_comment_count s_new_comment_count
            FROM cms_chapter c
                     RIGHT JOIN cms_section s
                                ON c.id = s.chapter_id
            WHERE module_id = #{moduleId}
        )
        UNION
        (
            SELECT c.*,
                   s.id                s_id,
                   s.title             s_title,
                   s.sort              s_sort,
                   s.chapter_id        s_chapter_id,
                   s.new_comment_count s_new_comment_count
            FROM cms_chapter c
                     LEFT JOIN cms_section s
                               ON c.id = s.chapter_id
            WHERE module_id = #{moduleId}
        )
        ORDER BY sort, s_sort
    </select>

    <select id="selectAllForUpdate"
            resultMap="cn.ncepu.alpl.mapper.CmsModuleMapper.BaseResultMap">
        SELECT *
        FROM cms_module
            FOR UPDATE
    </select>

    <select id="selectByIdForUpdate"
            resultMap="cn.ncepu.alpl.mapper.CmsModuleMapper.BaseResultMap">
        SELECT *
        FROM cms_module
        WHERE id = #{moduleId}
            FOR UPDATE
    </select>

    <update id="updateSortGreaterThanTheNum">
        UPDATE cms_module
        SET sort = sort + 1
        WHERE sort >= #{sort}
    </update>

    <update id="updateByIdSelective">
        UPDATE cms_module
        <set>
            <if test="module.name != null">
                name = #{module.name},
            </if>
            <if test="module.sort != null">
                sort = #{module.sort}
            </if>
        </set>
        WHERE id = #{module.id}
    </update>

</mapper>

