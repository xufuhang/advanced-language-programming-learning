    <select id="selectDetailListByCondition" resultMap="SelectUmsUserDetailMap">
        SELECT DISTINCT *
        FROM ums_user u
        <where>
            <if test="user.username != null">
                AND username LIKE concat("%", #{user.username}, "%")
            </if>
            <if test="user.nickname != null">
                AND nickname LIKE concat("%", #{user.nickname}, "%")
            </if>
            <if test="user.status != null">
                AND status = #{user.status}
            </if>
        </where>
    </select>

    <select id="selectRoleListByUserId" resultType="cn.ncepu.alpl.model.UmsRole">
        SELECT r.*
        FROM ums_user_role_relation urr
                 LEFT JOIN ums_role r ON urr.role_id = r.id
        WHERE urr.user_id = #{id}
    </select>

    <select id="selectByKeywordAndRoleName" resultType="cn.ncepu.alpl.model.UmsUser">
        SELECT u.*
        FROM ums_user u
        INNER JOIN ums_user_role_relation urr on u.id = urr.user_id
        <where>
            <if test="keyword != null and keyword != ''">
                username LIKE concat("%",#{keyword},"%")
                OR nickname LIKE concat("%",#{keyword},"%")
            </if>
            <if test="roleId != null and roleId != ''">
                urr.role_id = #{roleId}
            </if>
        </where>
    </select>

