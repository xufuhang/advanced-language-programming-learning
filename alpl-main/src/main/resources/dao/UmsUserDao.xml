<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.ncepu.alpl.dao.UmsUserDao">

    <resultMap id="UmsUserDetailMap" type="cn.ncepu.alpl.domain.UmsUserDetail"
               extends="cn.ncepu.alpl.mapper.UmsUserMapper.BaseResultMap">
        <collection property="roleList"
                    resultMap="cn.ncepu.alpl.mapper.UmsRoleMapper.BaseResultMap"
                    columnPrefix="r_">
        </collection>
        <collection property="resourceList"
                    resultMap="cn.ncepu.alpl.mapper.UmsResourceMapper.BaseResultMap"
                    columnPrefix="re_">
        </collection>
        <collection property="optionList"
                    resultMap="cn.ncepu.alpl.mapper.UmsOptionMapper.BaseResultMap"
                    columnPrefix="o_">
        </collection>
    </resultMap>

    <resultMap id="SelectUmsUserDetailMap" type="cn.ncepu.alpl.domain.UmsUserDetail"
               extends="cn.ncepu.alpl.mapper.UmsUserMapper.BaseResultMap">
        <collection property="roleList"
                    select="cn.ncepu.alpl.dao.UmsRoleDao.selectListByUserId"
                    column="id">
        </collection>
    </resultMap>

    <insert id="insertList">
        INSERT INTO ums_user (username, password, nickname, status, create_time)
        VALUES
        <foreach collection="list" separator="," item="item" index="index">
            (#{item.username}, #{item.password}, #{item.nickname}, #{item.status}, #{item.createTime})
        </foreach>
    </insert>

    <update id="updateById">
        UPDATE ums_user
        SET login_time = #{user.loginTime}
        WHERE id = #{user.id}
    </update>

    <select id="selectUserDetailByUsername" resultMap="UmsUserDetailMap">
        SELECT DISTINCT u.*,
                        r.id        r_id,
                        name        r_name,
                        description r_description
        FROM ums_user u
                 LEFT JOIN ums_user_role_relation urr on u.id = urr.user_id
                 LEFT JOIN ums_role r on urr.role_id = r.id
        WHERE u.username = #{username};
    </select>

    <select id="selectUserByUsername" resultType="cn.ncepu.alpl.model.UmsUser">
        SELECT *
        FROM ums_user
        WHERE username = #{username}
    </select>

